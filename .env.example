# Database
DATABASE_URL=sqlite+aiosqlite:///./secure_db.db

# JWT
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
CURRENT_KEY=YWJjZGVmZ2hpamsxMjM0NTY3ODkwYWJjZGVmZ2hpamsxMjM0NTY3ODkw
OLD_KEYS=YWJjZGVmZ2hpamsxMjM0NTY3ODkwYWJjZGVmZ2hpamsxMjM0NTY3ODkw

# Redis (fakeredis will be used if not available)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security
CSRF_SECRET=your_csrf_secret_key
RATE_LIMIT_GENERAL=100
RATE_LIMIT_SENSITIVE=5

# Log
LOG_LEVEL=INFO
LOG_FILE=app.log